<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="divo-token" content="__TOKEN__">
<title>ZERO EVO · Panel</title>
<style>
:root {
  --bg: #f7f3ed; --surface: #ffffff; --surface-2: #f1ebe2; --ink: #211b17; --muted: #6b6159; --line: #e3dacd;
  --accent: #c2410c; --on-accent: #ffffff; --ok: #15803d; --bad: #c0261b; --panel: #15110e; --led-off: #2a221d;
  --radius: 14px; --s1: 4px; --s2: 8px; --s3: 12px; --s4: 16px; --s5: 24px; --s6: 32px;
  --mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
  --sans: system-ui, "Segoe UI", Roboto, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #14110f; --surface: #1d1916; --surface-2: #26201c; --ink: #f4ede4; --muted: #a89c90; --line: #332b25;
    --accent: #ff6018; --on-accent: #14110f; --ok: #4ade80; --bad: #ff7a6e; --panel: #0b0907; --led-off: #221b16;
  }
}
:root[data-theme="dark"] {
  --bg: #14110f; --surface: #1d1916; --surface-2: #26201c; --ink: #f4ede4; --muted: #a89c90; --line: #332b25;
  --accent: #ff6018; --on-accent: #14110f; --ok: #4ade80; --bad: #ff7a6e; --panel: #0b0907; --led-off: #221b16;
}
* { box-sizing: border-box; }
html { color-scheme: light dark; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--sans); }
button, input, select { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
h1, h2, h3 { margin: 0; line-height: 1.2; }
h2 { font-size: 22px; margin-bottom: var(--s4); }
h3 { font-size: 15px; margin-bottom: var(--s2); }
p { margin: 0 0 var(--s3); }
.muted { color: var(--muted); }
.mono { font-family: var(--mono); }

/* top bar: always visible, so the screen, connection and the two big switches are one click away */
.top { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: var(--s4); flex-wrap: wrap;
  padding: var(--s3) var(--s5); background: var(--surface); border-bottom: 1px solid var(--line); }
.brand { font-family: var(--mono); font-weight: 700; letter-spacing: .02em; display: flex; align-items: center; gap: var(--s2); }
.brand i { width: 12px; height: 12px; background: var(--accent); display: inline-block; border-radius: 3px; }
.now { display: flex; align-items: center; gap: var(--s3); min-width: 0; flex: 1 1 260px; }
.now .txt { min-width: 0; }
.now .label { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--bad); display: inline-block; margin-right: 6px; }
.dot.on { background: var(--ok); }
.quick { display: flex; gap: var(--s4); align-items: center; flex-wrap: wrap; }

.shell { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--s5); max-width: 1120px; margin: 0 auto; padding: var(--s5); }
nav { display: flex; flex-direction: column; gap: var(--s1); position: sticky; top: 84px; align-self: start; }
nav button { text-align: left; background: none; border: 0; padding: 10px var(--s3); border-radius: 10px; cursor: pointer; color: var(--muted); }
nav button:hover { background: var(--surface-2); color: var(--ink); }
nav button[aria-current="page"] { background: var(--surface-2); color: var(--ink); font-weight: 600; box-shadow: inset 3px 0 0 var(--accent); }
@media (max-width: 760px) {
  .shell { grid-template-columns: 1fr; padding: var(--s4); gap: var(--s3); }
  nav { flex-direction: row; overflow-x: auto; position: static; padding-bottom: var(--s1); }
  nav button { white-space: nowrap; }
  .top { padding: var(--s3) var(--s4); }
}
[hidden] { display: none !important; }  /* classes like .stack set display and would otherwise win over the hidden attribute */

.card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--s4); margin-bottom: var(--s4); }
.grid { display: grid; gap: var(--s4); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
.row { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
.row.between { justify-content: space-between; }
.stack { display: flex; flex-direction: column; gap: var(--s3); }
.field { display: flex; flex-direction: column; gap: var(--s1); font-size: 13px; color: var(--muted); }
.field input, .field select { color: var(--ink); }
input[type=text], input[type=number], input[type=time], select {
  background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; min-height: 40px; min-width: 0; }
input[type=color] { width: 48px; height: 40px; padding: 2px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface-2); }
input[type=range] { accent-color: var(--accent); width: 100%; min-height: 32px; }
button.btn { background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 9px 14px; min-height: 40px; cursor: pointer; }
button.btn:hover { border-color: var(--muted); }
button.btn.primary { background: var(--accent); color: var(--on-accent); border-color: var(--accent); font-weight: 600; }
button.btn.danger { color: var(--bad); }
button.btn:disabled { opacity: .5; cursor: not-allowed; }
.chip { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; background: var(--surface-2); cursor: pointer; min-height: 32px; }
.chip[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }

.switch { position: relative; display: inline-flex; flex: none; }
.switch input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.switch span { width: 44px; height: 26px; border-radius: 999px; background: var(--line); transition: background .15s; position: relative; }
.switch span::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--surface); box-shadow: 0 0 0 1px var(--muted); transition: transform .15s; }
.switch input:checked + span { background: var(--accent); }
.switch input:checked + span::after { transform: translateX(18px); box-shadow: none; }
.switch input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
.setting { display: flex; align-items: center; justify-content: space-between; gap: var(--s4); padding: var(--s3) 0; border-top: 1px solid var(--line); }
.setting:first-of-type { border-top: 0; }
.setting .what b { display: block; font-weight: 600; }
.setting .what small { color: var(--muted); }

canvas.led { display: block; border-radius: 8px; background: var(--panel); }
.faces { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: var(--s3); }
.face { display: flex; flex-direction: column; align-items: center; gap: var(--s2); padding: var(--s3); border: 1px solid var(--line);
  border-radius: 12px; background: var(--surface-2); cursor: pointer; text-align: center; }
.face:hover { border-color: var(--accent); }
.face small { color: var(--muted); }
.mini-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); gap: var(--s2); }

.badge { font-family: var(--mono); font-size: 11px; padding: 1px 7px; border-radius: 6px; background: var(--surface-2); border: 1px solid var(--line); text-transform: uppercase; }
.badge.mcp { color: var(--accent); } .badge.hook { color: var(--ok); } .badge.gui { color: var(--ink); } .badge.system { color: var(--muted); }
.log { list-style: none; margin: 0; padding: 0; max-height: 360px; overflow: auto; }
.log li { display: flex; gap: var(--s3); align-items: baseline; padding: 7px 0; border-top: 1px solid var(--line); font-size: 14px; }
.log li:first-child { border-top: 0; }
.log time { color: var(--muted); font-family: var(--mono); font-size: 12px; flex: none; }
.log .bad { color: var(--bad); }
.readout { font-family: var(--mono); font-size: 44px; font-weight: 700; letter-spacing: .04em; }
.days { display: flex; gap: 4px; flex-wrap: wrap; }
.btn-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--s2); }
.btn-grid .btn { text-align: left; }
.score { display: flex; align-items: center; gap: var(--s3); }
.score b { font-family: var(--mono); font-size: 32px; min-width: 56px; text-align: center; }
.rot { display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: var(--s2); align-items: center; padding-bottom: var(--s3); border-bottom: 1px solid var(--line); }
.rot select, .rot input[type=text] { width: 100% !important; }
.empty { color: var(--muted); padding: var(--s3) 0; }
.banner { border-color: var(--accent); }
.sw { display: inline-block; width: 12px; height: 12px; border-radius: 4px; margin-right: 6px; vertical-align: -1px; }
.site-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 8px; background: var(--muted); }
.small { font-size: 13px; }
ul.tips { margin: 0; padding-left: var(--s5); } ul.tips li { margin-bottom: var(--s2); }
#toast { position: fixed; bottom: var(--s5); left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 10px 18px; border-radius: 12px; opacity: 0; pointer-events: none; transition: opacity .2s; max-width: 90vw; z-index: 9; }
#toast.show { opacity: 1; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>

<header class="top">
  <div class="brand"><i></i>ZERO EVO Panel</div>
  <div class="now">
    <canvas id="miniScreen" class="led" aria-hidden="true"></canvas>
    <div class="txt">
      <div class="label" id="nowLabel">Connecting</div>
      <div class="muted" style="font-size:13px"><span class="dot" id="connDot"></span><span id="connText">Looking for the speaker</span></div>
    </div>
  </div>
  <div class="quick">
    <label class="row" style="gap:8px"><span class="switch"><input type="checkbox" role="switch" id="agentSwitch"><span></span></span> Agent control</label>
    <label class="row" style="gap:8px"><span class="switch"><input type="checkbox" role="switch" id="pinSwitch"><span></span></span> Pin display</label>
    <button class="btn" id="themeBtn" aria-label="Switch light or dark theme">Theme</button>
  </div>
</header>

<div class="shell">
  <nav aria-label="Sections" id="nav">
    <button data-tab="dash">Dashboard</button>
    <button data-tab="live">Live status</button>
    <button data-tab="agent">Agent</button>
    <button data-tab="faces">Faces and text</button>
    <button data-tab="modes">Speaker modes</button>
    <button data-tab="apps">Timers and meters</button>
    <button data-tab="monitors">Monitors and weather</button>
    <button data-tab="schedule">Schedule</button>
    <button data-tab="settings">Settings</button>
  </nav>

  <main>
    <!-- DASHBOARD -->
    <section id="tab-dash">
      <h2>Dashboard</h2>
      <div class="card banner" id="heldBanner" hidden><div class="row between"><span id="heldText"></span><button class="btn primary" id="resumeBtn">Resume live status</button></div></div>
      <p class="muted" id="sessionSummary"></p>
      <div class="grid">
        <div class="card">
          <h3>On the speaker now</h3>
          <div class="row" style="align-items:flex-start">
            <canvas id="bigScreen" class="led" aria-label="Live copy of the speaker screen"></canvas>
            <div class="stack" style="flex:1; min-width:180px">
              <div><div id="dashLabel" style="font-weight:600">-</div>
                <div class="muted" style="font-size:13px">set by <span class="badge" id="dashSource">-</span> <span id="dashAge"></span></div></div>
              <div id="dashCaption" class="muted" style="font-size:13px"></div>
            </div>
          </div>
        </div>
        <div class="card">
          <h3>Brightness</h3>
          <input type="range" id="brightness" min="0" max="100" step="5" aria-label="Brightness">
          <div class="row between"><span class="muted" id="brightText"></span><span class="mono" id="brightVal"></span></div>
          <h3 style="margin-top:var(--s4)">Quick faces</h3>
          <div class="mini-grid" id="quickFaces"></div>
        </div>
      </div>
      <div class="card">
        <h3>Activity</h3>
        <p class="muted" style="font-size:13px">Everything that changed the screen, and anything the agent tried that your settings blocked.</p>
        <ul class="log" id="log"></ul>
      </div>
    </section>

    <!-- LIVE STATUS -->
    <section id="tab-live" hidden>
      <h2>Live status</h2>
      <p class="muted">How the speaker shows what your agent sessions are doing. It follows the hooks on its own.</p>
      <div class="card"><div class="row between"><h3 style="margin:0">Sessions</h3><button class="btn" id="resumeBtn2">Resume live status</button></div>
        <div id="sessionList"></div></div>
      <div class="card" id="ciCard" hidden><div class="row between"><div><h3 style="margin-bottom:var(--s1)">Build after your last push</h3><div id="ciText"></div></div><button class="btn" id="ciDismiss">Dismiss</button></div></div>
      <div class="grid">
        <div class="card stack"><h3>What it shows</h3>
          <label class="field">When several sessions are open<select data-set="scene.mode"><option value="auto">A board: one small face per session, up to four</option><option value="single">Only the busiest session</option></select></label>
          <div class="setting"><div class="what"><b>Tool pictures</b><small>The face alternates with a big picture of the tool in use.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.glyphs" aria-label="Tool pictures"><span></span></label></div>
          <div class="setting"><div class="what"><b>Activity heartbeat</b><small>A strip along the bottom: a spark for each tool call.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.heartbeat" aria-label="Activity heartbeat"><span></span></label></div>
          <div class="setting"><div class="what"><b>Sub-agent dots</b><small>One dot along the top for each running sub-agent.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.agent_dots" aria-label="Sub-agent dots"><span></span></label></div>
          <div class="setting"><div class="what"><b>Build dot</b><small>A corner square that follows the GitHub Actions run after a push.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.ci_dot" aria-label="Build dot"><span></span></label></div>
          <div class="setting"><div class="what"><b>Reactions</b><small>Confetti and a glitch when a tool fails. Off also hides test results.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.reactions" aria-label="Reactions"><span></span></label></div>
          <div class="setting"><div class="what"><b>Test results</b><small>A big pass count over a green and red bar for a few seconds after the agent runs your tests. Off shows confetti or a glitch instead.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.test_results" aria-label="Test results"><span></span></label></div>
          <div class="setting"><div class="what"><b>Elapsed clock</b><small>Minutes over seconds since you sent the prompt, shown in the cycle after 20 seconds of work.</small></div><label class="switch"><input type="checkbox" role="switch" data-set="scene.elapsed_clock" aria-label="Elapsed clock"><span></span></label></div>
        </div>
        <div class="card stack"><h3>Timing</h3>
          <label class="field">Start sweating after a task runs this long (seconds)<input type="number" min="30" max="3600" data-set="scene.sweat_after_s"></label>
          <label class="field">A face you or the agent picks stays this long before live status returns (seconds)<input type="number" min="0" max="600" data-set="scene.hold_seconds"></label>
        </div>
      </div>
      <div class="card"><h3>Tool pictures</h3><p class="muted small">Switch one off and that tool shows the face only. The Tool pictures switch above turns them all off.</p><div class="faces" id="glyphGallery"></div></div>
      <div class="card"><h3>Reading the screen</h3>
        <ul class="tips muted">
          <li><b>Strip along the bottom:</b> activity heartbeat. One column per 5 seconds, a spark for each tool call, so you can see a busy or stalled session from across the room.</li>
          <li><b>Dots along the top left:</b> running sub-agents.</li>
          <li><b>Square in the top right:</b> the build after a push. Amber blinking is running, green passed, red failed.</li>
          <li><b>Sweat drops:</b> the task has been running a long time.</li>
          <li><b>Hopping and waving, with yellow sparkles:</b> The agent is waiting on you. It breaks through a clock or timer for a few seconds, then goes back.</li>
          <li><b>Confetti:</b> a push went through or tests ran. <b>A big number over a bar:</b> test results. <b>Glitch:</b> a tool failed.</li>
          <li><b>Board:</b> each small face has a coloured stripe on top that matches the colour in the session list above.</li>
        </ul></div>
    </section>

    <!-- AGENT -->
    <section id="tab-agent" hidden>
      <h2>What the agent may do</h2>
      <p class="muted">These rules apply to the agent's tools and to the automatic status hooks. Your own clicks in this panel are never limited. A blocked request shows up in Activity, and the agent is told why.</p>
      <div class="card">
        <div class="setting"><div class="what"><b>Agent control</b><small>Master switch. Off means the agent and the hooks cannot touch the screen at all.</small></div>
          <label class="switch"><input type="checkbox" role="switch" data-set="agent.enabled" aria-label="Agent control"><span></span></label></div>
        <div class="setting"><div class="what"><b>Automatic status faces</b><small>Faces that follow what the agent is doing (thinking, working, done, needs you). No tool call needed.</small></div>
          <label class="switch"><input type="checkbox" role="switch" data-set="agent.hooks" aria-label="Automatic status faces"><span></span></label></div>
        <div class="setting"><div class="what"><b>The agent may override a pinned display</b><small>Normally pinning blocks the agent completely.</small></div>
          <label class="switch"><input type="checkbox" role="switch" data-set="agent.override_pin" aria-label="Override pin"><span></span></label></div>
      </div>
      <div class="card"><h3>Tools the agent can call</h3><div id="toolList"></div></div>
      <div class="card"><h3>Faces the agent can show</h3>
        <p class="muted" style="font-size:13px">Switch a face off and the agent can no longer show it (the hooks skip it too).</p>
        <div class="faces" id="moodToggles"></div></div>
      <div class="grid">
        <div class="card stack"><h3>Limits</h3>
          <label class="field">Minimum seconds between the agent's changes<input type="number" min="0" max="60" step="0.5" data-set="agent.min_interval_s"></label>
          <label class="field">Longest scrolling message (characters)<input type="number" min="1" max="60" data-set="agent.max_text_chars"></label>
          <div class="row"><label class="field">Dimmest the agent can set<input type="number" min="0" max="100" data-set="agent.brightness_min"></label>
            <label class="field">Brightest the agent can set<input type="number" min="0" max="100" data-set="agent.brightness_max"></label></div>
        </div>
        <div class="card stack"><h3>Quiet hours</h3>
          <div class="setting" style="border:0;padding:0"><div class="what"><b>Block the agent during these hours</b><small>The screen keeps whatever it shows.</small></div>
            <label class="switch"><input type="checkbox" role="switch" data-set="agent.quiet_hours.enabled" aria-label="Quiet hours"><span></span></label></div>
          <div class="row"><label class="field">From<input type="time" data-set="agent.quiet_hours.start"></label>
            <label class="field">Until<input type="time" data-set="agent.quiet_hours.end"></label></div>
        </div>
      </div>
    </section>

    <!-- FACES AND TEXT -->
    <section id="tab-faces" hidden>
      <h2>Faces and text</h2>
      <div class="card"><h3>Agent faces</h3><p class="muted" style="font-size:13px">Click one to show it on the speaker.</p><div class="faces" id="faceGallery"></div></div>
      <div class="card stack"><h3>Scrolling message</h3>
        <div class="row">
          <label class="field" style="flex:1; min-width:200px">Message<input type="text" id="msgText" maxlength="60" placeholder="BACK IN 5 MIN"></label>
          <label class="field">Colour<input type="color" id="msgColor" value="#ff6018"></label>
          <label class="field">Speed<select id="msgSpeed"><option value="1">Slow</option><option value="2" selected>Normal</option><option value="3">Fast</option><option value="4">Faster</option></select></label>
          <button class="btn primary" id="msgSend" style="align-self:flex-end">Show</button>
        </div>
        <div class="row" id="msgSwatches" aria-label="Colour presets"></div>
        <p class="muted" style="font-size:13px;margin:0">Letters, numbers and . ! ? : - + / _ , % ' ( ) are supported.</p>
      </div>
    </section>

    <!-- SPEAKER MODES -->
    <section id="tab-modes" hidden>
      <h2>Speaker modes</h2>
      <p class="muted">The speaker's own built-in displays.</p>
      <div class="grid">
        <div class="card stack"><h3>Clock</h3>
          <label class="field">Style<select id="clockStyle"></select></label>
          <div class="row"><label class="field">Colour<input type="color" id="clockColor" value="#ffffff"></label>
            <button class="chip" id="clkTime" aria-pressed="true">Time</button><button class="chip" id="clkWeather" aria-pressed="false">Weather</button>
            <button class="chip" id="clkTemp" aria-pressed="false">Temperature</button><button class="chip" id="clkCal" aria-pressed="false">Calendar</button></div>
          <button class="btn primary" id="clockApply">Show clock</button></div>
        <div class="card stack"><h3>Light</h3>
          <label class="field">Type<select id="lightType"></select></label>
          <div class="row"><label class="field">Colour<input type="color" id="lightColor" value="#ff6018"></label>
            <label class="field" style="flex:1">Brightness<input type="range" id="lightBright" min="5" max="100" value="100"></label></div>
          <button class="btn primary" id="lightApply">Show light</button></div>
      </div>
      <div class="card"><h3>Effects</h3><div class="btn-grid" id="effectBtns"></div></div>
      <div class="card"><h3>Music visualizer</h3><p class="muted" style="font-size:13px">Reacts to sound playing through the speaker.</p><div class="btn-grid" id="vizBtns"></div></div>
      <div class="grid">
        <div class="card stack"><h3>Scoreboard</h3>
          <div class="row" style="justify-content:space-around">
            <div class="score"><button class="btn" data-score="red" data-d="-1" aria-label="Red minus one">-</button><b id="scoreRed">0</b><button class="btn" data-score="red" data-d="1" aria-label="Red plus one">+</button></div>
            <div class="score"><button class="btn" data-score="blue" data-d="-1" aria-label="Blue minus one">-</button><b id="scoreBlue">0</b><button class="btn" data-score="blue" data-d="1" aria-label="Blue plus one">+</button></div>
          </div>
          <div class="row between"><span class="muted">Red and blue players</span><button class="btn" id="scoreReset">Reset</button></div></div>
        <div class="card stack"><h3>Weather and time</h3>
          <div class="row"><label class="field">Temperature (C)<input type="number" id="wxTemp" value="25" min="-50" max="100" style="width:110px"></label>
            <label class="field">Sky<select id="wxKind"></select></label></div>
          <div class="row"><button class="btn primary" id="wxSend">Send weather</button><button class="btn" id="syncTime">Sync clock to this PC</button></div></div>
      </div>
    </section>

    <!-- APPS -->
    <section id="tab-apps" hidden>
      <h2>Timers and meters</h2>
      <div class="card stack"><h3>Timer</h3>
        <div id="timerRun" hidden>
          <div class="row between"><div><div class="readout" id="timerReadout">00:00</div><div class="muted" id="timerSub"></div></div>
            <div class="row"><button class="btn" id="timerPause">Pause</button><button class="btn danger" id="timerStop">Stop</button></div></div>
        </div>
        <div id="timerSetup" class="stack">
          <div class="row" id="timerPresets"></div>
          <div class="row"><label class="field">Minutes<input type="number" id="tMin" min="1" max="1439" value="25" style="width:100px"></label>
            <label class="field" style="flex:1;min-width:160px">Label (optional)<input type="text" id="tLabel" maxlength="30" placeholder="Focus"></label>
            <button class="btn primary" id="tStart" style="align-self:flex-end">Start countdown</button>
            <button class="btn" id="swStart" style="align-self:flex-end">Stopwatch</button></div>
          <p class="muted" style="font-size:13px;margin:0">The screen shows minutes over seconds and a progress bar. When it ends, the face waves at you.</p></div>
      </div>
      <div class="grid">
        <div class="card stack"><h3>System meter</h3>
          <p class="muted" style="font-size:13px;margin:0">Two bars on the screen: CPU on top, memory below. Green, amber, red.</p>
          <div id="sysLive" class="mono muted"></div>
          <div class="row"><button class="btn primary" id="sysStart">Start</button><button class="btn" id="sysStop">Stop</button></div></div>
        <div class="card stack"><h3>Rotation</h3>
          <p class="muted" style="font-size:13px;margin:0">Cycle through faces, messages and the system meter on its own.</p>
          <div id="rotList" class="stack"></div>
          <div class="row"><button class="btn" id="rotAdd">Add step</button><button class="btn primary" id="rotStart">Start</button><button class="btn" id="rotStop">Stop</button></div></div>
      </div>
      <div class="grid">
        <div class="card stack"><h3>Network latency</h3>
          <p class="muted small" style="margin:0">A graph of how long a connection to 1.1.1.1 takes, newest on the right. Green is quick, red is slow, a red dot at the bottom means the probe failed.</p>
          <div class="row"><button class="btn primary" id="netStart">Start</button><button class="btn" id="netStop">Stop</button></div></div>
        <div class="card stack"><h3>Battery and disk</h3>
          <p class="muted small" style="margin:0">Two bars: battery on top (left out on a desktop PC) and how full the system drive is below. Fuller is redder.</p>
          <div class="row"><button class="btn primary" id="stoStart">Start</button><button class="btn" id="stoStop">Stop</button></div></div>
      </div>
    </section>

    <!-- MONITORS AND WEATHER -->
    <section id="tab-monitors" hidden>
      <h2>Monitors and weather</h2>
      <div class="card stack"><h3>Sites</h3>
        <p class="muted small" style="margin:0">A site counts as down after two misses in a row. Then the screen flashes its name, and it shows green again when it recovers.</p>
        <div id="siteList"></div>
        <div class="row" style="align-items:flex-end">
          <label class="field">Name<input type="text" id="siteName" maxlength="30" placeholder="My site" style="width:150px"></label>
          <label class="field" style="flex:1;min-width:200px">Address<input type="text" id="siteUrl" placeholder="https://example.com"></label>
          <button class="btn primary" id="siteAdd">Add site</button></div>
        <div class="row"><button class="btn" id="monStart">Show the grid on the speaker</button><button class="btn" id="monStop">Stop</button>
          <label class="row" style="gap:8px"><span class="switch"><input type="checkbox" role="switch" data-set="monitors.alert" aria-label="Flash when a site goes down"><span></span></span> Flash when a site goes down</label>
          <label class="field" style="flex-direction:row;align-items:center;gap:8px">Check every<input type="number" min="10" max="3600" data-set="monitors.interval_s" style="width:80px">seconds</label></div>
        <p class="muted small" style="margin:0">On the speaker: one square per site, up to 16. Green is up, amber is slow, red is down, grey is waiting for the first check.</p>
      </div>
      <div class="card stack"><h3>Weather</h3>
        <div class="setting" style="border:0;padding:0"><div class="what"><b>Send the real weather to the speaker</b><small>Refreshed every 20 minutes. Only your chosen city's coordinates go to Open-Meteo, a free service with no account.</small></div>
          <label class="switch"><input type="checkbox" role="switch" data-set="weather.enabled" aria-label="Weather"><span></span></label></div>
        <div class="row" style="align-items:flex-end"><label class="field" style="flex:1;min-width:200px">City<input type="text" id="wxCity" placeholder="Search for a city"></label>
          <button class="btn" id="wxSearch">Search</button></div>
        <div id="wxResults" class="stack"></div>
        <div id="wxNow" class="muted"></div>
        <p class="muted small" style="margin:0">To see it, use Speaker modes, Clock, and switch on Weather and Temperature.</p>
      </div>
    </section>

    <!-- SCHEDULE -->
    <section id="tab-schedule" hidden>
      <h2>Schedule</h2>
      <div class="card stack"><h3>Reminders</h3>
        <p class="muted" style="font-size:13px;margin:0">At the set time the screen flashes a message or face, then goes back to what it was showing.</p>
        <div id="remList"></div>
        <div class="row" style="align-items:flex-end">
          <label class="field">Time<input type="time" id="rTime" value="09:00"></label>
          <label class="field" style="flex:1;min-width:160px">Message (or leave empty for a face)<input type="text" id="rText" maxlength="40" placeholder="STAND UP"></label>
          <label class="field">Face<select id="rMood"></select></label>
          <label class="field">Seconds<input type="number" id="rSecs" value="20" min="5" max="300" style="width:90px"></label>
        </div>
        <div class="row"><div class="days" id="rDays" role="group" aria-label="Days"></div><button class="btn primary" id="rAdd">Add reminder</button></div>
      </div>
      <div class="grid">
        <div class="card stack"><h3>Night mode</h3>
          <div class="setting" style="border:0;padding:0"><div class="what"><b>Dim at night</b><small>Lowers the brightness in this window.</small></div>
            <label class="switch"><input type="checkbox" role="switch" data-set="night.enabled" aria-label="Night mode"><span></span></label></div>
          <div class="row"><label class="field">From<input type="time" data-set="night.start"></label><label class="field">Until<input type="time" data-set="night.end"></label>
            <label class="field">Brightness<input type="number" min="0" max="100" data-set="night.brightness" style="width:90px"></label></div></div>
        <div class="card stack"><h3>Go to sleep when idle</h3>
          <p class="muted" style="font-size:13px;margin:0">If a face the agent set stays untouched this long, the sleeping face appears. Your own clock, light and timers are never interrupted. 0 turns it off.</p>
          <label class="field">Minutes<input type="number" min="0" max="240" data-set="idle_sleep_minutes" style="width:110px"></label></div>
      </div>
    </section>

    <!-- SETTINGS -->
    <section id="tab-settings" hidden>
      <h2>Settings</h2>
      <div class="card stack"><h3>Speaker</h3>
        <div class="row"><label class="field">Bluetooth address<input type="text" data-set="device.address" class="mono" style="width:190px" placeholder="AA:BB:CC:DD:EE:FF"></label>
          <label class="field">Serial channel<input type="number" min="1" max="30" data-set="device.channel" style="width:90px"></label>
          <button class="btn" id="findSpeaker" style="align-self:flex-end">Find my speaker</button>
          <button class="btn" id="reconnect" style="align-self:flex-end">Reconnect</button></div>
        <div id="devResults" class="stack"></div>
        <div id="connErr" class="muted" style="font-size:13px"></div>
        <p class="muted" style="font-size:13px;margin:0">The speaker accepts one controller at a time. Close the Divoom phone app while this is connected.</p>
      </div>
      <div class="card">
        <div class="setting"><div class="what"><b>Start with Windows</b><small>Launches the background service when you sign in, so the speaker is ready.</small></div>
          <label class="switch"><input type="checkbox" role="switch" data-set="autostart" aria-label="Start with Windows"><span></span></label></div>
        <div class="setting"><div class="what"><b>Set the speaker's clock on connect</b><small>Copies this PC's time each time it connects.</small></div>
          <label class="switch"><input type="checkbox" role="switch" data-set="sync_time_on_connect" aria-label="Sync time on connect"><span></span></label></div>
      </div>
      <div class="card"><h3>Open this panel later</h3>
        <p class="muted small">The service runs in the background with no window. Put an icon where you can click it to come back here.</p>
        <div class="row"><button class="btn" id="addShortcut">Add a desktop shortcut</button><button class="btn" id="addStartMenu">Add to the Start menu</button></div></div>
      <div class="card"><h3>Background service</h3>
        <p class="muted" style="font-size:13px">It holds the Bluetooth link. Stopping it frees the speaker for the phone app; it restarts the next time the agent or this panel needs it.</p>
        <button class="btn danger" id="quitBtn">Stop service</button></div>
    </section>
  </main>
</div>
<div id="toast" role="status" aria-live="polite"></div>

<script>
"use strict";
const TOKEN = document.querySelector('meta[name=divo-token]').content;
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
const css = (v) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
let META = null, SETTINGS = null, STATE = null, PREVIEW_ID = -1;

function el(tag, props = {}, ...kids) {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(props)) {
    if (k === 'class') e.className = v; else if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
    else if (v === true) e.setAttribute(k, ''); else if (v !== false && v != null) e.setAttribute(k, v);
  }
  for (const c of kids.flat()) e.append(c instanceof Node ? c : document.createTextNode(c));
  return e;
}
async function api(path, body) {
  const r = await fetch(path, {
    method: body === undefined ? 'GET' : 'POST',
    headers: { 'X-Divo': '1', 'Content-Type': 'application/json', 'X-Divo-Token': TOKEN },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  return r.json();
}
const cmd = async (req, quiet) => {
  try {
    const r = await api('/api/cmd', { req, source: 'gui' });
    if (!r.ok && !quiet) toast(r.error || r.denied || 'Request failed');
    refresh();
    return r;
  } catch (e) { toast('Cannot reach the service'); }
};
let toastTimer;
function toast(msg) {
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove('show'), 3500);
}
const hex2rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));

/* ---- LED screen drawing ---- */
function ledCanvas(size, cls = 'led') {
  const c = el('canvas', { class: cls }); const dpr = devicePixelRatio || 1;
  c.width = c.height = Math.round(size * dpr); c.style.width = c.style.height = size + 'px'; return c;
}
function prepCanvas(c, size) {
  const dpr = devicePixelRatio || 1; c.width = c.height = Math.round(size * dpr); c.style.width = c.style.height = size + 'px';
}
function drawLed(c, hex) {
  const g = c.getContext('2d'), s = c.width, cell = s / 16;
  g.fillStyle = css('--panel'); g.fillRect(0, 0, s, s);
  const off = css('--led-off');
  for (let i = 0; i < 256; i++) {
    const x = i % 16, y = (i / 16) | 0;
    if (hex) {
      const r = parseInt(hex.substr(i * 6, 2), 16), gg = parseInt(hex.substr(i * 6 + 2, 2), 16), b = parseInt(hex.substr(i * 6 + 4, 2), 16);
      g.fillStyle = r + gg + b > 0 ? `rgb(${r},${gg},${b})` : off;
    } else g.fillStyle = off;
    g.beginPath(); g.arc((x + .5) * cell, (y + .5) * cell, cell * .4, 0, 6.2832); g.fill();
  }
}
class Player {
  constructor(canvas) { this.c = canvas; this.t = null; this.frames = null; }
  play(frames) {
    clearTimeout(this.t); this.frames = frames;
    if (!frames) return drawLed(this.c, null);
    if (reduceMotion || frames.length === 1) return drawLed(this.c, frames[0].hex);
    let i = 0;
    const step = () => { drawLed(this.c, frames[i].hex); const d = Math.max(60, frames[i].delay); i = (i + 1) % frames.length; this.t = setTimeout(step, d); };
    step();
  }
  redraw() { this.play(this.frames); }
}

/* ---- tabs ---- */
function showTab(name) {
  if (!$('#tab-' + name)) name = 'dash';
  $$('main > section').forEach((s) => (s.hidden = s.id !== 'tab-' + name));
  $$('#nav button').forEach((b) => b.setAttribute('aria-current', b.dataset.tab === name ? 'page' : 'false'));
  history.replaceState(null, '', '#' + name);
}
$('#nav').addEventListener('click', (e) => { const b = e.target.closest('button'); if (b) showTab(b.dataset.tab); });

/* ---- settings binding ---- */
const getPath = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : a[k]), o);
function patchFor(path, value) { const root = {}; let o = root; const ks = path.split('.'); ks.forEach((k, i) => { o[k] = i === ks.length - 1 ? value : (o[k] = {}); o = o[k]; }); return root; }
async function saveSettings(patch) {
  try { SETTINGS = await api('/api/settings', patch); renderSettings(); } catch (e) { toast('Could not save'); }
}
function renderSettings() {
  $$('[data-set]').forEach((i) => {
    const v = getPath(SETTINGS, i.dataset.set);
    if (v === undefined || document.activeElement === i) return;
    if (i.type === 'checkbox') i.checked = !!v; else i.value = v;
  });
  $$('[data-tool]').forEach((i) => (i.checked = !!SETTINGS.agent.tools[i.dataset.tool]));
  $$('[data-mood]').forEach((i) => (i.checked = !!SETTINGS.agent.moods[i.dataset.mood]));
  $$('[data-glyph]').forEach((i) => (i.checked = SETTINGS.scene.tool_pictures[i.dataset.glyph] !== false));
  $('#agentSwitch').checked = SETTINGS.agent.enabled;
  renderReminders(); renderRotation(); renderMonitors();
}
document.addEventListener('change', (e) => {
  const i = e.target; if (!i.dataset) return;
  if (i.dataset.set) {
    let v = i.type === 'checkbox' ? i.checked : i.type === 'number' ? Number(i.value) : i.value;
    if (i.type === 'number' && !Number.isFinite(v)) return;
    saveSettings(patchFor(i.dataset.set, v));
  } else if (i.dataset.tool) saveSettings({ agent: { tools: { [i.dataset.tool]: i.checked } } });
  else if (i.dataset.mood) saveSettings({ agent: { moods: { [i.dataset.mood]: i.checked } } });
  else if (i.dataset.glyph) saveSettings({ scene: { tool_pictures: { [i.dataset.glyph]: i.checked } } });
});
$('#agentSwitch').addEventListener('change', (e) => saveSettings({ agent: { enabled: e.target.checked } }));
$('#pinSwitch').addEventListener('change', (e) => cmd({ cmd: 'pin', value: e.target.checked }));

/* ---- state polling ---- */
const bigPlayer = new Player($('#bigScreen')), miniPlayer = new Player($('#miniScreen'));
const ago = (s) => (s < 5 ? 'just now' : s < 90 ? Math.round(s) + 's ago' : s < 5400 ? Math.round(s / 60) + ' min ago' : Math.round(s / 3600) + ' h ago');
const fmtClock = (secs) => { secs = Math.max(0, Math.round(secs)); const h = (secs / 3600) | 0, m = ((secs % 3600) / 60) | 0, s = secs % 60; return (h ? h + ':' + String(m).padStart(2, '0') : String(m).padStart(2, '0')) + ':' + String(s).padStart(2, '0'); };
async function refresh() {
  let s; try { s = await api('/api/state'); } catch (e) { $('#connText').textContent = 'Service stopped'; $('#connDot').classList.remove('on'); return; }
  STATE = s; renderState(s); renderLive(s);
  if (s.current.preview_id !== PREVIEW_ID) {
    PREVIEW_ID = s.current.preview_id;
    const p = await api('/api/preview');
    bigPlayer.play(p.frames); miniPlayer.play(p.frames);
    $('#dashCaption').textContent = p.frames ? '' : 'The speaker is drawing this one itself, so there is no copy to show here.';
  }
}
function renderState(s) {
  $('#connDot').classList.toggle('on', s.connected);
  $('#connText').textContent = s.connected ? 'Connected to ' + s.address : 'Not connected' + (s.error ? ' · ' + s.error : '');
  $('#connErr').textContent = s.connected ? '' : s.error;
  $('#nowLabel').textContent = s.current.label;
  $('#dashLabel').textContent = s.current.label;
  const src = $('#dashSource'); src.textContent = s.current.source; src.className = 'badge ' + s.current.source;
  $('#dashAge').textContent = ago(s.current.age);
  $('#pinSwitch').checked = s.pinned;
  const br = $('#brightness');
  if (document.activeElement !== br) br.value = s.brightness;
  $('#brightVal').textContent = s.brightness + '%';
  $('#brightText').textContent = s.effective_brightness !== s.brightness ? 'Night mode is dimming it to ' + s.effective_brightness + '%' : '';
  $('#scoreRed').textContent = s.scoreboard.red; $('#scoreBlue').textContent = s.scoreboard.blue;
  const log = $('#log'); log.replaceChildren();
  if (!s.log.length) log.append(el('li', { class: 'empty' }, 'Nothing yet.'));
  for (const e of s.log) {
    log.append(el('li', {}, el('time', {}, new Date(e.t * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })),
      el('span', { class: 'badge ' + e.source }, e.source),
      el('span', { class: e.ok ? '' : 'bad' }, e.action + (e.detail ? ' · ' + e.detail : ''))));
  }
  for (const ev of s.events) toast(ev.type === 'timer_done' ? 'Timer finished: ' + ev.label : 'Reminder: ' + ev.label);
  const a = s.app, tm = a && a.name === 'timer' ? a.timer : null;
  $('#timerRun').hidden = !tm; $('#timerSetup').hidden = !!tm;
  if (tm) {
    $('#timerReadout').textContent = fmtClock(tm.kind === 'countdown' ? Math.ceil(tm.remaining) : tm.elapsed);
    $('#timerSub').textContent = (tm.label || tm.kind) + (tm.paused ? ' · paused' : '');
    $('#timerPause').textContent = tm.paused ? 'Resume' : 'Pause';
  }
  $('#sysLive').textContent = a && a.name === 'sysmon' && a.cpu != null ? `CPU ${a.cpu.toFixed(0)}%   Memory ${a.ram.toFixed(0)}%` : (a && a.name === 'rotation' ? 'Rotation is running' : '');
}
$('#brightness').addEventListener('input', (e) => { $('#brightVal').textContent = e.target.value + '%'; });
$('#brightness').addEventListener('change', (e) => cmd({ cmd: 'brightness', value: Number(e.target.value) }));

/* ---- faces ---- */
function faceCard(name, onClick, sub) {
  const c = ledCanvas(64), p = new Player(c); p.play(META.moods[name].frames);
  return el('button', { class: 'face', onclick: onClick, title: META.moods[name].desc }, c, el('b', {}, name), sub ? el('small', {}, sub) : '');
}
function buildFaces() {
  const names = Object.keys(META.moods);
  $('#faceGallery').replaceChildren(...names.map((n) => faceCard(n, () => cmd({ cmd: 'face', mood: n }), META.moods[n].desc.split(':')[0])));
  $('#quickFaces').replaceChildren(...names.map((n) => {
    const c = ledCanvas(40); new Player(c).play(META.moods[n].frames);
    return el('button', { class: 'face', style: 'padding:8px', onclick: () => cmd({ cmd: 'face', mood: n }), 'aria-label': 'Show ' + n + ' face' }, c, el('small', {}, n));
  }));
  $('#moodToggles').replaceChildren(...names.map((n) => {
    const c = ledCanvas(48); new Player(c).play(META.moods[n].frames);
    return el('label', { class: 'face', style: 'cursor:default' }, c, el('b', {}, n), el('span', { class: 'switch' }, el('input', { type: 'checkbox', role: 'switch', 'data-mood': n, 'aria-label': 'Allow ' + n + ' face' }), el('span')));
  }));
  $('#toolList').replaceChildren(...Object.entries(META.tools).map(([t, d]) =>
    el('div', { class: 'setting' }, el('div', { class: 'what' }, el('b', { class: 'mono' }, t), el('small', {}, d)),
      el('label', { class: 'switch' }, el('input', { type: 'checkbox', role: 'switch', 'data-tool': t, 'aria-label': 'Allow ' + t }), el('span')))));
  $('#rMood').replaceChildren(...names.map((n) => el('option', { value: n, selected: n === 'attention' }, n)));
}
const SWATCHES = ['#ff6018', '#ffffff', '#00ff3c', '#00b4ff', '#ff2d6f', '#ffd400', '#b366ff'];
function buildText() {
  $('#msgSwatches').replaceChildren(...SWATCHES.map((c) => el('button', { class: 'chip', style: `border-left:14px solid ${c}`, 'aria-label': 'Colour ' + c, onclick: () => ($('#msgColor').value = c) }, c)));
  const send = () => { const t = $('#msgText').value.trim(); if (t) cmd({ cmd: 'text', text: t, color: hex2rgb($('#msgColor').value), speed: Number($('#msgSpeed').value) }); };
  $('#msgSend').onclick = send; $('#msgText').addEventListener('keydown', (e) => e.key === 'Enter' && send());
}

/* ---- modes ---- */
const flag = (id) => $(id).getAttribute('aria-pressed') === 'true';
function buildModes() {
  $('#clockStyle').replaceChildren(...META.clock_styles.map((n, i) => el('option', { value: i }, n)));
  $('#lightType').replaceChildren(...META.light_types.map((n, i) => el('option', { value: i }, n)));
  $('#wxKind').replaceChildren(...META.weather.map((n) => el('option', { value: n }, n[0].toUpperCase() + n.slice(1))));
  ['#clkTime', '#clkWeather', '#clkTemp', '#clkCal'].forEach((id) => ($(id).onclick = () => $(id).setAttribute('aria-pressed', !flag(id))));
  $('#clockApply').onclick = () => cmd({ cmd: 'mode', mode: 'clock', style: Number($('#clockStyle').value), color: hex2rgb($('#clockColor').value), time: flag('#clkTime'), weather: flag('#clkWeather'), temp: flag('#clkTemp'), calendar: flag('#clkCal') });
  $('#lightApply').onclick = () => cmd({ cmd: 'mode', mode: 'light', kind: Number($('#lightType').value), color: hex2rgb($('#lightColor').value), brightness: Number($('#lightBright').value) });
  $('#effectBtns').replaceChildren(...META.effects.map((n, i) => el('button', { class: 'btn', onclick: () => cmd({ cmd: 'mode', mode: 'effect', kind: i }) }, n)));
  $('#vizBtns').replaceChildren(...Array.from({ length: META.visualizer_count }, (_, i) => el('button', { class: 'btn', onclick: () => cmd({ cmd: 'mode', mode: 'visualizer', kind: i }) }, 'Visualizer ' + (i + 1))));
  const score = (d) => { const sb = STATE ? { ...STATE.scoreboard } : { red: 0, blue: 0 }; return cmd({ cmd: 'mode', mode: 'scoreboard', red: Math.max(0, sb.red + (d.red || 0)), blue: Math.max(0, sb.blue + (d.blue || 0)) }); };
  $$('[data-score]').forEach((b) => (b.onclick = () => score({ [b.dataset.score]: Number(b.dataset.d) })));
  $('#scoreReset').onclick = () => cmd({ cmd: 'mode', mode: 'scoreboard', red: 0, blue: 0 });
  $('#wxSend').onclick = () => cmd({ cmd: 'weather', temp: Number($('#wxTemp').value), weather: $('#wxKind').value }).then((r) => r && r.ok && toast('Weather sent. Show it with the Clock option Weather / Temperature.'));
  $('#syncTime').onclick = () => cmd({ cmd: 'synctime' }).then((r) => r && r.ok && toast('Speaker clock set to this PC'));
}

/* ---- apps ---- */
function buildApps() {
  $('#timerPresets').replaceChildren(...[[5, '5 min'], [10, '10 min'], [15, '15 min'], [25, 'Pomodoro 25'], [45, '45 min'], [60, '1 hour']].map(([m, n]) =>
    el('button', { class: 'chip', onclick: () => cmd({ cmd: 'timer', action: 'start', kind: 'countdown', seconds: m * 60, label: m === 25 ? 'Focus' : '' }) }, n)));
  $('#tStart').onclick = () => cmd({ cmd: 'timer', action: 'start', kind: 'countdown', seconds: Math.round(Number($('#tMin').value) * 60), label: $('#tLabel').value });
  $('#swStart').onclick = () => cmd({ cmd: 'timer', action: 'start', kind: 'stopwatch', seconds: 86399, label: $('#tLabel').value });
  $('#timerPause').onclick = () => cmd({ cmd: 'timer', action: STATE && STATE.app && STATE.app.timer && STATE.app.timer.paused ? 'resume' : 'pause' });
  $('#timerStop').onclick = () => cmd({ cmd: 'timer', action: 'stop' });
  $('#sysStart').onclick = () => cmd({ cmd: 'app', name: 'sysmon', action: 'start' });
  $('#sysStop').onclick = () => cmd({ cmd: 'app', name: 'sysmon', action: 'stop' });
  $('#rotStart').onclick = () => cmd({ cmd: 'app', name: 'rotation', action: 'start' });
  $('#rotStop').onclick = () => cmd({ cmd: 'app', name: 'rotation', action: 'stop' });
  [['net', 'net'], ['sto', 'storage']].forEach(([id, name]) => {
    $('#' + id + 'Start').onclick = () => cmd({ cmd: 'app', name, action: 'start' });
    $('#' + id + 'Stop').onclick = () => cmd({ cmd: 'app', name, action: 'stop' });
  });
  $('#rotAdd').onclick = () => saveSettings({ rotation: { items: [...SETTINGS.rotation.items, { type: 'face', mood: 'idle', seconds: 10 }] } });
}
function renderRotation() {
  const items = SETTINGS.rotation.items, save = () => saveSettings({ rotation: { items } });
  const list = $('#rotList');
  if (document.activeElement && list.contains(document.activeElement)) return;
  list.replaceChildren(...items.map((it, i) => {
    const type = el('select', { 'aria-label': 'Step type', onchange: (e) => { const t = e.target.value; items[i] = t === 'face' ? { type: t, mood: 'idle', seconds: it.seconds } : t === 'text' ? { type: t, text: 'HELLO', seconds: it.seconds } : { type: 'app', name: 'sysmon', seconds: it.seconds }; save(); } },
      ...[['face', 'Face'], ['text', 'Message'], ['app', 'System meter']].map(([v, n]) => el('option', { value: v, selected: it.type === v }, n)));
    const val = it.type === 'face' ? el('select', { 'aria-label': 'Face', onchange: (e) => { it.mood = e.target.value; save(); } }, ...Object.keys(META.moods).map((n) => el('option', { value: n, selected: it.mood === n }, n)))
      : it.type === 'text' ? el('input', { type: 'text', value: it.text || '', maxlength: 28, 'aria-label': 'Message', style: 'width:130px', onchange: (e) => { it.text = e.target.value; save(); } }) : el('span', { class: 'muted' }, 'CPU and memory');
    const secs = el('input', { type: 'number', min: 3, max: 600, value: it.seconds || 10, 'aria-label': 'Seconds', style: 'width:72px', onchange: (e) => { it.seconds = Number(e.target.value); save(); } });
    return el('div', { class: 'rot' }, type, val, el('label', { class: 'row', style: 'gap:6px;flex-wrap:nowrap' }, secs, el('span', { class: 'muted' }, 'sec')),
      el('button', { class: 'btn', 'aria-label': 'Remove step', onclick: () => { items.splice(i, 1); save(); } }, 'Remove'));
  }));
}

/* ---- schedule ---- */
const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
let newDays = [0, 1, 2, 3, 4, 5, 6];
function buildSchedule() {
  const paint = () => $('#rDays').replaceChildren(...DAYS.map((d, i) => el('button', { class: 'chip', 'aria-pressed': newDays.includes(i), onclick: () => { newDays = newDays.includes(i) ? newDays.filter((x) => x !== i) : [...newDays, i]; paint(); } }, d)));
  paint();
  $('#rAdd').onclick = () => {
    if (!newDays.length) return toast('Pick at least one day');
    const r = { id: String(Date.now()), time: $('#rTime').value || '09:00', days: [...newDays].sort(), text: $('#rText').value.trim().toUpperCase(), mood: $('#rMood').value, seconds: Number($('#rSecs').value) || 20, enabled: true };
    saveSettings({ reminders: [...SETTINGS.reminders, r] }); $('#rText').value = '';
  };
}
function renderReminders() {
  const box = $('#remList');
  if (!SETTINGS.reminders.length) return box.replaceChildren(el('div', { class: 'empty' }, 'No reminders yet.'));
  box.replaceChildren(...SETTINGS.reminders.map((r) => el('div', { class: 'setting' },
    el('div', { class: 'what' }, el('b', { class: 'mono' }, r.time + '  ' + (r.text || r.mood)), el('small', {}, (r.days.length === 7 ? 'Every day' : r.days.map((d) => DAYS[d]).join(' ')) + ' · ' + r.seconds + 's')),
    el('div', { class: 'row' },
      el('label', { class: 'switch' }, el('input', { type: 'checkbox', role: 'switch', checked: r.enabled, 'aria-label': 'Enable reminder', onchange: (e) => { r.enabled = e.target.checked; saveSettings({ reminders: SETTINGS.reminders }); } }), el('span')),
      el('button', { class: 'btn', onclick: () => saveSettings({ reminders: SETTINGS.reminders.filter((x) => x.id !== r.id) }) }, 'Delete')))));
}

/* ---- settings tab ---- */
function buildSettingsTab() {
  $('#reconnect').onclick = async () => { await api('/api/reconnect', {}); toast('Reconnecting'); };
  const shortcut = (where, label) => async () => {
    const r = await api('/api/shortcut', { where });
    toast(r.ok ? 'Added to ' + label : 'Could not add it: ' + (r.error || 'unknown error'));
  };
  $('#addShortcut').onclick = shortcut('desktop', 'your desktop');
  $('#addStartMenu').onclick = shortcut('startmenu', 'the Start menu');
  $('#findSpeaker').onclick = async () => {
    const box = $('#devResults'); box.replaceChildren(el('span', { class: 'muted' }, 'Looking at your paired Bluetooth devices'));
    let r; try { r = await api('/api/discover'); } catch (e) { r = { devices: [] }; }
    box.replaceChildren(...(r.devices.length ? r.devices.map((d) => el('button', { class: 'btn', style: 'text-align:left',
      onclick: () => { saveSettings({ device: { address: d.address } }); box.replaceChildren(); api('/api/reconnect', {}); toast('Using ' + d.name); } },
      d.name + '  ' + d.address)) : [el('span', { class: 'muted' }, 'No Divoom speaker found. Pair it in Windows Bluetooth settings first, then try again.')]));
  };
  let armed = false;
  $('#quitBtn').onclick = async (e) => {
    if (!armed) { armed = true; e.target.textContent = 'Click again to stop'; setTimeout(() => { armed = false; e.target.textContent = 'Stop service'; }, 3000); return; }
    await api('/api/quit', {}); toast('Service stopped. Close this tab.');
  };
  $('#themeBtn').onclick = () => {
    const dark = document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.dataset.theme = dark ? 'light' : 'dark';
    try { localStorage.setItem('divo-theme', document.documentElement.dataset.theme); } catch (e) {}
    bigPlayer.redraw(); miniPlayer.redraw();
  };
  try { const t = localStorage.getItem('divo-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
}

/* ---- live status ---- */
const STATE_TEXT = { idle: 'idle', thinking: 'thinking', working: 'working', attention: 'needs you', done: 'done', error: 'error', sleep: 'asleep' };
function setList(node, sig, build) {
  if (node.dataset.sig === sig) return;
  node.dataset.sig = sig; node.replaceChildren(...build());
}
const dur = (s) => (s < 90 ? Math.round(s) + 's' : Math.round(s / 60) + ' min');
const TOOL_NAMES = { bash: 'Terminal', edit: 'Edit files', read: 'Read files', write: 'Write files', search: 'Search', web: 'Web', agent: 'Sub-agents', test: 'Tests', git: 'Git' };
function buildLive() {
  const resume = () => cmd({ cmd: 'scene', action: 'resume' });
  $('#resumeBtn').onclick = resume; $('#resumeBtn2').onclick = resume;
  $('#ciDismiss').onclick = () => cmd({ cmd: 'scene', action: 'dismiss_ci' });
  $('#glyphGallery').replaceChildren(...Object.entries(META.glyphs).map(([k, hex]) => {
    const c = ledCanvas(56); drawLed(c, hex);
    return el('div', { class: 'face', style: 'cursor:default' }, c, el('b', {}, TOOL_NAMES[k] || k),
      el('span', { class: 'switch' }, el('input', { type: 'checkbox', role: 'switch', 'data-glyph': k, 'aria-label': 'Show the ' + (TOOL_NAMES[k] || k) + ' picture' }), el('span')));
  }));
}
function renderLive(s) {
  const held = s.scene.held;
  $('#heldBanner').hidden = !held;
  if (held) {
    const why = s.app ? 'a ' + s.app.name + ' is running' : s.scene.holding_for === 'forever' ? 'you chose a speaker mode'
      : 'a face you or the agent picked stays for ' + s.scene.holding_for + ' more seconds';
    $('#heldText').textContent = "The agent's live status is paused: " + why + '.';
  }
  const ss = s.sessions;
  $('#sessionSummary').textContent = ss.length
    ? (ss.length === 1 ? '1 agent session: ' : ss.length + ' agent sessions: ') + ss.map((x) => (x.project || 'session') + ' ' + STATE_TEXT[x.state]).join(', ')
    : 'No agent sessions yet. They appear as soon as OpenClaw (or another agent) runs.';
  const sig = JSON.stringify(ss.map((x) => [x.id, x.state, x.tool, x.agents, Math.floor((x.elapsed || 0) / 5), Math.floor((x.waiting_for || 0) / 5), Math.floor(x.idle_for / 30)]));
  setList($('#sessionList'), sig, () => ss.length ? ss.map((x) => el('div', { class: 'setting' },
    el('div', { class: 'what' }, el('b', {}, el('span', { class: 'sw', style: 'background:rgb(' + x.color.join(',') + ')' }), x.project || 'session'),
      el('small', {}, [x.state === 'working' && x.tool ? 'using ' + x.tool : '', x.agents ? x.agents + ' sub-agent' + (x.agents > 1 ? 's' : '') : '',
        x.elapsed != null ? 'task running ' + dur(x.elapsed) : '', x.waiting_for != null ? 'waiting on you for ' + dur(x.waiting_for) : '',
        'last activity ' + dur(x.idle_for) + ' ago'].filter(Boolean).join(' · '))),
    el('span', { class: 'badge' }, STATE_TEXT[x.state]))) : [el('div', { class: 'empty' }, 'Nothing yet. Sessions show up here when the agent runs its hooks.')]);
  $('#ciCard').hidden = !s.ci;
  if (s.ci) $('#ciText').textContent = s.ci.repo + '@' + s.ci.branch + ' (' + s.ci.sha + '): ' + ({ waiting: 'waiting for the run to start', running: 'running', success: 'passed', failure: 'failed' }[s.ci.state] || s.ci.state);
  renderMonitors();
}

/* ---- monitors and weather ---- */
function buildMonitors() {
  $('#siteAdd').onclick = () => {
    let url = $('#siteUrl').value.trim(); if (!url) return;
    if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
    const name = $('#siteName').value.trim() || url.replace(/^https?:\/\//i, '').replace(/\/.*$/, '');
    saveSettings({ monitors: { items: [...SETTINGS.monitors.items, { id: String(Date.now()), name, url, enabled: true }] } });
    $('#siteName').value = ''; $('#siteUrl').value = '';
  };
  $('#monStart').onclick = () => cmd({ cmd: 'app', name: 'monitors', action: 'start' });
  $('#monStop').onclick = () => cmd({ cmd: 'app', name: 'monitors', action: 'stop' });
  const search = async () => {
    const q = $('#wxCity').value.trim(); if (q.length < 2) return;
    const box = $('#wxResults'); box.replaceChildren(el('span', { class: 'muted' }, 'Searching'));
    let r; try { r = await api('/api/geocode?q=' + encodeURIComponent(q)); } catch (e) { r = { results: [], error: 'offline' }; }
    box.replaceChildren(...(r.results.length ? r.results.map((c) => el('button', { class: 'btn', style: 'text-align:left',
      onclick: () => { saveSettings({ weather: { enabled: true, city: c.name, lat: c.lat, lon: c.lon } }); box.replaceChildren(); $('#wxCity').value = ''; } },
      [c.name, c.region, c.country].filter(Boolean).join(', '))) : [el('span', { class: 'muted' }, r.error ? 'Could not search (' + r.error + ')' : 'No city found')]));
  };
  $('#wxSearch').onclick = search; $('#wxCity').addEventListener('keydown', (e) => e.key === 'Enter' && search());
}
function renderMonitors() {
  if (!SETTINGS) return;
  const items = SETTINGS.monitors.items, res = {};
  for (const m of (STATE && STATE.monitors) || []) res[m.id] = m;
  const sig = JSON.stringify([items, Object.values(res).map((r) => [r.id, r.up, r.ms])]);
  setList($('#siteList'), sig, () => items.length ? items.map((it) => {
    const r = res[it.id];
    const text = !it.enabled ? 'paused' : !r ? 'checking' : r.up === true ? r.ms + ' ms' + (r.error ? ' · ' + r.error : '') : r.up === false ? 'down' + (r.error ? ' · ' + r.error : '') : 'not sure yet';
    const color = !it.enabled || !r || r.up == null ? 'var(--muted)' : r.up ? ((r.ms || 0) > 2000 ? '#d97706' : 'var(--ok)') : 'var(--bad)';
    return el('div', { class: 'setting' },
      el('div', { class: 'what' }, el('b', {}, el('span', { class: 'site-dot', style: 'background:' + color }), it.name), el('small', { class: 'mono' }, it.url + ' · ' + text)),
      el('div', { class: 'row' },
        el('label', { class: 'switch' }, el('input', { type: 'checkbox', role: 'switch', checked: it.enabled, 'aria-label': 'Watch ' + it.name,
          onchange: (e) => { it.enabled = e.target.checked; saveSettings({ monitors: { items } }); } }), el('span')),
        el('button', { class: 'btn', onclick: () => saveSettings({ monitors: { items: items.filter((x) => x.id !== it.id) } }) }, 'Remove')));
  }) : [el('div', { class: 'empty' }, 'No sites yet. Add one below.')]);
  const w = STATE && STATE.weather, cfg = SETTINGS.weather;
  $('#wxNow').textContent = !cfg.enabled ? (cfg.city ? cfg.city + ' is chosen, but weather is switched off.' : 'Search for a city to start.')
    : !w ? 'Fetching weather for ' + cfg.city : w.error ? 'Could not fetch weather (' + w.error + ')' : cfg.city + ': ' + w.temp + '°C, ' + w.sky + ' (sent to the speaker)';
}

/* ---- boot ---- */
async function boot() {
  prepCanvas($('#bigScreen'), 224); prepCanvas($('#miniScreen'), 44);
  try { META = await api('/api/meta'); SETTINGS = await api('/api/settings'); } catch (e) { $('#nowLabel').textContent = 'Cannot reach the service'; return; }
  buildFaces(); buildText(); buildModes(); buildApps(); buildSchedule(); buildSettingsTab(); buildLive(); buildMonitors(); renderSettings();
  showTab(location.hash.slice(1) || 'dash');
  await refresh();
  setInterval(refresh, 1000);
}
boot();
</script>
</body>
</html>
